import { Text } from "./domain.eff"
import { PublishReceipt, PublishFailure } from "./feature.eff"
import { PlatformUnavailable } from "./platform.eff"

export error GrantDenied = { id: Text }
export error Revoked = {}

export type PublishOperation = (id: Text) => PublishReceipt
  fails PublishFailure | PlatformUnavailable

export type PublishGrant = {
  use: () => PublishReceipt
    fails PublishFailure | PlatformUnavailable | Revoked,
  revoke: () => void
}

export const grantPublishOne = (publish: PublishOperation, id: Text, authorizedIds: Text[]): PublishGrant
  fails GrantDenied => {
    const authorized = authorizedIds |> fold(false, (found, candidate) => found || candidate === id)
    if (authorized) {
      const live = makeRef(true)
      ({
        use: () => if (getRef(live)) { publish(id) } else { fail(Revoked({})) },
        revoke: () => setRef(live, false)
      })
    } else { fail(GrantDenied({ id })) }
  }
