import { PlatformUnavailable, Platform, TextRules, Time } from "./platform.eff"
import { Text, Instant } from "./domain.eff"
import { Clock, Lexical } from "./ports.eff"
import { ArticleJson, articleStoreLive } from "./storage.eff"
import { PublishReceipt, PublishFailure, publishArticleFeature, publishAllFeature } from "./feature.eff"

const clockLive = layer(Clock, () => {
  const time = Time.acquire()
  ({ now: () => Instant(time.nowMillis()) })
})

const lexicalLive = layer(Lexical, () => {
  const lexical = TextRules.acquire()
  ({
    isBlank: value => lexical.isBlank(value),
    isWellFormed: value => lexical.isWellFormed(value)
  })
})

const applicationLive = mergeLayers(articleStoreLive, mergeLayers(clockLive, lexicalLive))

export const publishArticle = (rawId: Text): PublishReceipt
  fails PublishFailure | PlatformUnavailable
  uses Platform.acquire | ArticleJson.acquire | TextRules.acquire | Time.acquire =>
  provide(applicationLive, () => publishArticleFeature(rawId))

export const publishAll = (rawIds: Text[]): PublishReceipt[]
  fails PublishFailure | PlatformUnavailable
  uses Platform.acquire | ArticleJson.acquire | TextRules.acquire | Time.acquire =>
  provide(applicationLive, () => publishAllFeature(rawIds))
