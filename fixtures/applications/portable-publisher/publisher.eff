import { Text, PlatformUnavailable, Platform, TextRules, Time } from "./platform.eff"
import { Instant, InvalidArticle, RevisionExhausted } from "./domain.eff"
import { Corrupt, StorageUnavailable, StorageUncertain, Clock, Lexical } from "./ports.eff"
import { ArticleJson, articleStoreLive } from "./storage.eff"
import { PublishReceipt, MissingArticle, PublishConflict, publishArticleFeature, publishAllFeature } from "./feature.eff"

const clockLive: Layer<Clock, never, Time.acquire> = layer(Clock, () => {
  const time = Time.acquire()
  ({ now: (): Instant => Instant(time.nowMillis()) })
})

const lexicalLive: Layer<Lexical, never, TextRules.acquire> = layer(Lexical, () => {
  const lexical = TextRules.acquire()
  ({
    isBlank: (value: Text) => lexical.isBlank(value),
    isWellFormed: (value: Text) => lexical.isWellFormed(value)
  })
})

const applicationLive = mergeLayers(articleStoreLive, mergeLayers(clockLive, lexicalLive))

export const publishArticle = (rawId: Text): PublishReceipt
  fails MissingArticle | InvalidArticle | RevisionExhausted | Corrupt | StorageUnavailable | StorageUncertain | PublishConflict | PlatformUnavailable
  uses Platform.acquire | ArticleJson.acquire | TextRules.acquire | Time.acquire =>
  provide(applicationLive, () => publishArticleFeature(rawId))

export const publishAll = (rawIds: Text[]): PublishReceipt[]
  fails MissingArticle | InvalidArticle | RevisionExhausted | Corrupt | StorageUnavailable | StorageUncertain | PublishConflict | PlatformUnavailable
  uses Platform.acquire | ArticleJson.acquire | TextRules.acquire | Time.acquire =>
  provide(applicationLive, () => publishAllFeature(rawIds))
