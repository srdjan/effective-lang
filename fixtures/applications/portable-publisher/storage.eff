import { Key, Payload, Version, KeyValue, LexicalOps, InvalidKey, InvalidPayload, PlatformUnavailable, CompareConflict, WriteUncertain, Platform, TextRules } from "./platform.eff"
import { Text, ArticleId, Revision, NonBlankText, Instant, Draft, Published, PublishPlan } from "./domain.eff"
import { SnapshotToken, Corrupt, StorageUnavailable, StorageUncertain, ArticleConflict, ArticleStore } from "./ports.eff"

export type StoredArticle = {
  kind: "draft" | "published",
  id: Text,
  revision: int,
  title: Text,
  body: Text,
  publishedAt?: int
}
export type ArticleCodec = {
  encode: (article: StoredArticle) => Payload,
  decode: (payload: Payload) => Option<StoredArticle>
}

export service ArticleJson {
  acquire(): ArticleCodec
}

export const storedArticleSchema: Schema<StoredArticle> = schema()

const keyOf = (id: ArticleId) => Key("articles/" + id)

const unavailable = (cause: unknown) => StorageUnavailable({ cause })

const readEntry = (store: KeyValue, id: ArticleId) => {
    const key = keyOf(id)
    try {
      match store.get(key) {
        Some(entry) => Some({ key, entry }),
        None => None
      }
    } catch {
      InvalidKey(error) => fail(Corrupt({ key: Text(key), reason: "invalid storage key" })),
      PlatformUnavailable(error) => fail(unavailable(error.cause))
    }
  }

const decodeStored = (serializer: ArticleCodec, key: Key, payload: Payload) =>
  serializer.decode(payload) ?? fail(Corrupt({ key: Text(key), reason: "invalid article payload" }))

const toArticle = (lexical: LexicalOps, key: Key, expectedId: ArticleId, stored: StoredArticle) => {
    const { id, revision, kind, title, body, publishedAt: publicationTime } = stored
    if (lexical.isBlank(id)) {
      fail(Corrupt({ key: Text(key), reason: "blank article id" }))
    } else if (ArticleId(id) !== expectedId) {
      fail(Corrupt({ key: Text(key), reason: "article identity mismatch" }))
    } else if (revision < 0) {
      fail(Corrupt({ key: Text(key), reason: "negative article revision" }))
    } else {
      match kind {
        "draft" => match publicationTime {
          Some(_instant) => fail(Corrupt({ key: Text(key), reason: "draft has publication time" })),
          None => Draft({
            id: ArticleId(id),
            revision: Revision(revision),
            title: title,
            body: body
          })
        },
        "published" => match publicationTime {
          Some(publishedAt) =>
            if (lexical.isBlank(title)) {
              fail(Corrupt({ key: Text(key), reason: "blank published title" }))
            } else if (lexical.isBlank(body)) {
              fail(Corrupt({ key: Text(key), reason: "blank published body" }))
            } else if (publishedAt < 0) {
              fail(Corrupt({ key: Text(key), reason: "negative publication time" }))
            } else {
              Published({
                id: ArticleId(id),
                revision: Revision(revision),
                title: NonBlankText(title),
                body: NonBlankText(body),
                publishedAt: Instant(publishedAt)
              })
            },
          None => fail(Corrupt({ key: Text(key), reason: "missing publication time" }))
        }
      }
    }
  }

const load = (store: KeyValue, serializer: ArticleCodec, lexical: LexicalOps, id: ArticleId) =>
  if (lexical.isBlank(Text(id))) {
    fail(Corrupt({ key: Text(keyOf(id)), reason: "blank article id" }))
  } else { match readEntry(store, id) {
    Some(found) => {
      const stored = decodeStored(serializer, found.key, found.entry.payload)
      Some({ article: toArticle(lexical, found.key, id, stored), token: SnapshotToken(found.entry.version) })
    },
    None => None
  } }

const storedPublished = (article: Published): StoredArticle => ({
  kind: "published",
  id: Text(article.id),
  revision: article.revision,
  title: Text(article.title),
  body: Text(article.body),
  publishedAt: article.publishedAt
})

const write = (store: KeyValue, serializer: ArticleCodec, plan: PublishPlan, token: SnapshotToken) => {
    const key = keyOf(plan.next.id)
    const payload = serializer.encode(storedPublished(plan.next))
    try {
      const _version = store.set(key, payload, Some(Version(token)))
    } catch {
      InvalidKey(error) => fail(Corrupt({ key: Text(key), reason: "invalid storage key" })),
      InvalidPayload(error) => fail(Corrupt({ key: Text(key), reason: "invalid storage payload" })),
      PlatformUnavailable(error) => fail(unavailable(error.cause)),
      CompareConflict(error) => fail(ArticleConflict({ id: plan.next.id })),
      WriteUncertain(error) => fail(StorageUncertain({ cause: error.cause }))
    }
  }

export const articleStoreLive: Layer<ArticleStore, PlatformUnavailable, Platform.acquire | ArticleJson.acquire | TextRules.acquire> = layer(ArticleStore, () => {
  const store = Platform.acquire()
  const serializer = ArticleJson.acquire()
  const lexical = TextRules.acquire()
  ({
    load: id => load(store, serializer, lexical, id),
    publish: (plan, token) => write(store, serializer, plan, token)
  })
})
