export type Text = string
export type Bool = boolean
export type ArticleId = string
export type Revision = int
export type NonBlankText = string
export type Instant = int

export type Draft = {
  id: ArticleId,
  revision: Revision,
  title: Text,
  body: Text
}

export type Published = {
  id: ArticleId,
  revision: Revision,
  title: NonBlankText,
  body: NonBlankText,
  publishedAt: Instant
}

export type Article = Draft | Published
export type ReadyDraft = {
  id: ArticleId,
  revision: Revision,
  title: NonBlankText,
  body: NonBlankText
}
export type InvalidDraft = {
  field: "revision" | "title" | "body",
  reason: Text
}
export type ExhaustedDraft = { id: ArticleId }
export type DraftAssessment = InvalidDraft | ExhaustedDraft | ReadyDraft
export type PublishPlan = { expectedRevision: Revision, next: Published }

export error InvalidArticle = {
  field: "id" | "revision" | "title" | "body",
  reason: Text
}
export error RevisionExhausted = { id: ArticleId }

export const articleId = (raw: Text, blank: Bool, wellFormed: Bool): Option<ArticleId> =>
  if (blank || wellFormed === false) { None } else { Some(ArticleId(raw)) }

export const assessDraft = (draft: Draft, titleBlank: Bool, bodyBlank: Bool): DraftAssessment =>
  if (draft.revision < 0) {
    InvalidDraft({ field: "revision", reason: "must be nonnegative" })
  } else if (draft.revision >= 9007199254740991) {
    ExhaustedDraft({ id: draft.id })
  } else if (titleBlank) {
    InvalidDraft({ field: "title", reason: "must not be blank" })
  } else if (bodyBlank) {
    InvalidDraft({ field: "body", reason: "must not be blank" })
  } else {
    ReadyDraft({
      id: draft.id,
      revision: draft.revision,
      title: NonBlankText(draft.title),
      body: NonBlankText(draft.body)
    })
  }

export const planPublication = (ready: ReadyDraft, now: Instant): PublishPlan => {
  const next = Published({
      id: ready.id,
      revision: Revision(ready.revision + 1),
      title: ready.title,
      body: ready.body,
      publishedAt: now
    })
  PublishPlan({ expectedRevision: ready.revision, next })
}
