export type Int = int
export type Text = string
export type Item = int | string
export type Pairs = Sink<Int, Int[], never, never, Int>
type Tail = string
export type Foreign = Sink<Int, Text, never, never, Tail>
export error SourceStop = {}
export error SinkStop = {}
export error BuildStop = {}
export service Pull { next(state: Int): Option<[Int, Int]> fails SourceStop }
export service Add { add(sum: Int, value: Int): Int fails SinkStop }
export service Factory {
  source(): Stream<Int, SourceStop, Pull.next> fails BuildStop
  sink(): Sink<Int, Int, SinkStop, Add.add, Int>
}
