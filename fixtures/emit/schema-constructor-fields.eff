export type Int = int
export type Text = string
export type D = { score: Int }
export type E = { score: Text }
export type M = { score?: Int }
type NullableE = E | null
type Required = { settings: D }
type Optional = { settings?: D }
type OptionalWire = { settings?: E }
type NullableWire = { settings?: NullableE }
type OptionalTextWire = { settings?: Text }
type RequiredTextWire = { settings: Text }
type Input = { settings?: M }
type OptionRecord = { settings: Option<D> }
type OptionInput = { settings?: Option<D> }

export service Read { parse(value: Text): Int }
export service Write { print(value: Int): Text }
export service Defaults { next(): D; encoded(): E }

const integer: Schema<Int> = schema()
const text: Schema<Text> = schema()
const shifted: Schema<Int, Text, Read.parse, Write.print> = schemaTransform(
  text, integer,
  (value: Text): Option<Int> uses Read.parse => Some(Read.parse(value)),
  (value: Int): Option<Text> uses Write.print => Some(Write.print(value))
)
const child: Schema<D, E, Read.parse, Write.print, M> =
  schemaStruct({ score: schemaConstructorDefault(shifted, (): Int => 4) })

export const optionalField: SchemaOptionalConstructorDefault<D, E, Read.parse, Write.print, M> =
  schemaConstructorDefault(schemaOptionalKey(child), (): M => ({}))
export const optionalRecord: Schema<Optional, OptionalWire, Read.parse, Write.print, Input> =
  schemaStruct({ settings: optionalField })
export const nullField: SchemaOptionalConstructorDefault<D, NullableE, Read.parse, Write.print, M> =
  schemaConstructorDefault(schemaNullToMissingKey(child), (): M => ({}))
export const nullRecord: Schema<Optional, NullableWire, Read.parse, Write.print, Input> = schemaStruct({ settings: nullField })
export const decodedField: SchemaEncodedOptionalConstructorDefault<D, E, Read.parse | Defaults.next, Write.print, M> =
  schemaConstructorDefault(schemaDefaultKey(child, (): D uses Defaults.next => Defaults.next()), (): M => ({}))
export const decodedRecord: Schema<Required, OptionalWire, Read.parse | Defaults.next, Write.print, Input> =
  schemaStruct({ settings: decodedField })
export const nullDefaultField: SchemaEncodedOptionalConstructorDefault<D, NullableE, Read.parse | Defaults.next, Write.print, M> =
  schemaConstructorDefault(schemaDefaultNullKey(child, (): D uses Defaults.next => Defaults.next()), (): M => ({}))
export const nullDefaultRecord: Schema<Required, NullableWire, Read.parse | Defaults.next, Write.print, Input> = schemaStruct({ settings: nullDefaultField })
export const encodedField: SchemaEncodedOptionalConstructorDefault<D, E, Read.parse | Defaults.encoded, Write.print, M> =
  schemaConstructorDefault(schemaDefaultEncodedKey(child, (): E uses Defaults.encoded => Defaults.encoded(), { encodingStrategy: "omit" }), (): M => ({}))
export const encodedRecord: Schema<Required, OptionalWire, Read.parse | Defaults.encoded, Write.print, Input> = schemaStruct({ settings: encodedField })
export const optionField: SchemaEncodedOptionalConstructorDefault<Option<D>, E, Read.parse, Write.print> =
  schemaConstructorDefault(schemaOptionFromOptionalKey(child), (): Option<D> => Some({ score: 6 }))
export const optionRecord: Schema<OptionRecord, OptionalWire, Read.parse, Write.print, OptionInput> =
  schemaStruct({ settings: optionField })

export const transformedField: SchemaOptionalConstructorDefault<D, Text, Read.parse, Write.print, M> =
  schemaConstructorDefault(schemaOptionalTransform(schemaOptionalKey(text), schemaOptionalKey(child),
    (value: Option<Text>): Option<E> => match value { Some(item) => Some({ score: item }), None => None },
    (value: Option<E>): Option<Text> => match value { Some(item) => Some(item.score), None => None }), (): M => ({}))
export const transformedRecord: Schema<Optional, OptionalTextWire, Read.parse, Write.print, Input> = schemaStruct({ settings: transformedField })
export const requiredField: SchemaDecodedOptionalConstructorDefault<D, Text, Read.parse, Write.print, M> =
  schemaConstructorDefault(schemaOptionalFromRequired(text, schemaOptionalKey(child),
    (value: Text): Option<E> => Some({ score: value }),
    (value: Option<E>): Text => match value { Some(item) => item.score, None => "" }), (): M => ({}))
export const requiredRecord: Schema<Optional, RequiredTextWire, Read.parse, Write.print, Input> = schemaStruct({ settings: requiredField })

export const waiting = (pending: Effect<M, SchemaIssue>): Schema<Optional, OptionalWire, Read.parse, Write.print, Input> =>
  schemaStruct({ settings: schemaConstructorDefault(schemaOptionalKey(child), (): M fails SchemaIssue => run(pending)) })
export const makeDecoded = (input: Input): Required fails SchemaIssue => schemaMake(decodedRecord, input)
export const readDecoded = (input: unknown): Required fails SchemaError uses Read.parse | Defaults.next => schemaDecode(decodedRecord, input)
export const writeEncoded = (input: Required): OptionalWire fails SchemaError uses Write.print => schemaEncode(encodedRecord, input)
