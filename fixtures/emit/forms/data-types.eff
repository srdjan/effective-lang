nominal UserId = string
type Text = string

export nominal User = { id: UserId, name: Text, nick?: Text }

nominal Twin = { id: UserId, name: Text, nick?: Text }

export nominal Marker = {}

export error Rejected = { user: User, reason: Text }

nominal Pin = { id: UserId }

export nominal Circle = { radius: Text }

export nominal Square = { side: Text }

export type Shape = Circle | Square

const userSchema: Schema<User> = schema()

export const make = (): User =>
  User({ id: UserId("u1"), name: "Ann" })

export const mark = (): Marker => Marker({})

export const nameOf = (user: User): Text => user.name

export const nick = (user: User): Text =>
  match user.nick {
    Some(n) => n,
    None => "none"
  }

export const rename = (user: User, name: Text): User =>
  ({ ...user, name })

export const plain = (user: User): { id: UserId, name: Text, nick?: Text } =>
  unbrand(user)

export const twin = (user: User): Twin => Twin(unbrand(user))

export const piped = (): Pin => ({ id: UserId("p1") }) |> Pin

export const reject = (user: User): Rejected =>
  Rejected({ user, reason: "no" })

export const decodeUser = (input: unknown): User fails SchemaError =>
  schemaDecode(userSchema, input)

export const encodeUser = (user: User): User fails SchemaError =>
  schemaEncode(userSchema, user)

export const circle = (): Shape => Circle({ radius: "r" })

export const square = (): Shape => Square({ side: "s" })

export const describe = (shape: Shape): Text =>
  match shape {
    Circle(c) => c.radius,
    Square(q) => q.side
  }

export const circular = (shape: Shape): Text =>
  match shape {
    Circle(c) => c.radius,
    _ => "other"
  }

export const outcome = (value: Circle | Rejected): Text =>
  match value {
    Circle(c) => c.radius,
    Rejected(r) => r.reason
  }

export const kind = (value: Marker | Circle): Text =>
  match value {
    Marker(m) => "marker",
    Circle(c) => c.radius
  }
