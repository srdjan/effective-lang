// Forms for the emitter tests. The tests check that the emitted code compiles
// and, for some functions, that it runs. This file is not a golden example.
type Status = "pending" | "paid"
type Acc = { n: int, label: string }
type Flags = true | false
type Small = 1 | 2
type Nada = void
type Unreachable = never
type Mixed = "a" | 1 | true
type Unions = string | int
type Raw = { raw: unknown, nothing: Nada, small: Small, flags: Flags, mixed: Mixed, either: Unions }
type Pair = [int, string]
type Profile = { name: string, nickname?: string, tags: string[], pair: Pair, maybe: Option<string> }
type Shape = { kind: "circle", radius: number } | { kind: "square", side: number }
type Callback = (n: int) => int
type CbBox = { run: Callback, label: string }
nominal Id = string

error NotFound = { id: Id }
error Empty = {}
error Other = { why: string }

service Store {
  find(id: Id): Option<Profile> fails NotFound
  count(): IntVal
  tick(): void
}

export const extent = (s: Shape): NumVal =>
  match s {
    { kind: "circle", ...c } => c.radius,
    { kind: "square", ...q } => q.side
  }

export const extent2 = (s: Shape): NumVal =>
  match s {
    { kind: "circle" } => 1,
    { kind: "square" } => 2
  }

export const lit = (s: StrVal): IntVal => match s { "a" => 1, "b" => 2, _ => 3 }
export const bool = (b: BoolVal): IntVal => match b { true => 1, false => 0 }
export const mul = (a: IntVal, b: IntVal): IntVal => a * b
export const arith = (a: IntVal, b: IntVal): IntVal => a * b + a - b
export const divide = (a: IntVal, b: IntVal): NumVal => a / b
export const nick = (p: Profile): Option<StrVal> => p.nickname
export const cond = (b: BoolVal, x: IntVal): StrVal => if (b) { "a" } else { "b" }
export const prof = (p: Profile): Profile => ({ ...p, name: "x" })
export const blockF = (x: IntVal): IntVal => {
  const y = x + 1
  const z: IntVal = y * 2
  z
}
export const nestedBlockPure = (o: Option<IntVal>): IntVal =>
  match o {
    Some(x) => { const y = x + 1
 y },
    None => 0
  }
export const brand = (s: StrVal): Id => Id(s)
export const unb = (i: Id): StrVal => StrVal(i)
export const cbCall = (b: CbBox, x: IntVal): IntVal => b.run(x)
export const mkBox = (): CbBox => ({ run: (n) => n + 1, label: "l" })

export const lookup = (id: Id): Profile
  fails NotFound
  uses Store.find =>
  match Store.find(id) {
    Some(p) => p,
    None => fail(NotFound({ id }))
  }

export const both = (id: Id, b: BoolVal): StrVal
  fails NotFound | Other
  uses Store.find =>
  if (b) { fail(NotFound({ id })) } else { fail(Other({ why: "w" })) }

export const lookup2 = (id: Id, b: BoolVal): StrVal
  fails Other
  uses Store.find =>
  try {
    both(id, b)
  } catch {
    NotFound(e) => fail(Other({ why: "n" })),
    Other(o) => "x"
  }

export const hoist = (id: Id, n: IntVal): IntVal
  fails NotFound
  uses Store.find | Store.count =>
  Store.count() + n

export const hoist2 = (id: Id): IntVal
  fails NotFound
  uses Store.find | Store.count =>
  add(lookup(id).tags |> map((t) => 1) |> fold(0, (a, b) => a + b), Store.count())

export const add = (a: IntVal, b: IntVal): IntVal => a + b

export const ifEff = (id: Id, b: BoolVal): StrVal
  fails NotFound
  uses Store.find =>
  if (b) { lookup(id).name } else { "none" }

export const andEff = (a: BoolVal): BoolVal
  uses Store.count =>
  a && Store.count() > 1

export const matchEff = (id: Id): IntVal
  uses Store.count =>
  match Store.count() { 1 => 10, _ => 20 }

export const nestedEff = (id: Id): IntVal
  fails NotFound
  uses Store.find | Store.count => {
  const n = Store.count()
  const p = lookup(id)
  n + 1
}

export const pureBlockEff = (id: Id): IntVal
  uses Store.count => {
  const n = Store.count()
  const m = match Some(n) {
    Some(x) => { const q = x + 1
 q },
    None => 0
  }
  m
}

export const unitF = (): void
  uses Store.tick => {
  Store.tick()
}

export const retried = (): IntVal
  uses Store.count =>
  retry(() => Store.count(), { times: 3 })

export const fnArg = (xs: IntVal[]): IntVal[] => xs |> map((x) => x * 2)
export const total = (xs: StrVal[]): IntVal => xs |> fold(0, (acc, x) => acc + 1)
const cfg: IntVal = base + 1
const base: IntVal = 1
export const useCfg = (): IntVal => cfg

export const applyTwice = (f: Callback, x: IntVal): IntVal => f(f(x))
const addOne = (n: IntVal): IntVal => n + 1
export const useLift = (x: IntVal): IntVal => applyTwice(addOne, x)
export const useLiftClosure = (x: IntVal): IntVal => applyTwice((n) => n * 2, x)

export const mkEmpty = (): StrVal fails Empty => fail(Empty({}))
export const withNick = (p: Profile): Profile => ({ ...p, nickname: "k" })
const readCount = (): IntVal uses Store.count => Store.count()
export const retryNamed = (): IntVal uses Store.count => retry(readCount, { times: 1 })
const two = (): IntVal => 2
export const retryPure = (): IntVal => retry(() => 2, { times: 1 })
export const retryPureNamed = (): IntVal => retry(two, { times: 1 })
export const caught = (id: Id): StrVal
  uses Store.find =>
  try { lookup(id).name } catch { NotFound(e) => "missing" }
export const pureEval = (x: IntVal): IntVal => {
  add(x, 1)
  x
}
export const optMatch = (p: Profile): StrVal =>
  match p.nickname { Some(n) => n, None => "anon" }
export const statusName = (s: Status): StrVal =>
  match s { "pending" => "p", "paid" => "q" }
export const adder = (n: IntVal): (x: IntVal) => IntVal => (x) => x + n
export const sumAll = (xs: IntVal[]): IntVal => xs |> fold(0, (a, b) => a + b)
export const names = (ps: Profile[]): StrVal[] => ps |> map((p) => p.name)
export const sumRec = (xs: IntVal[]): Acc =>
  xs |> fold({ n: 0, label: "x" }, (acc, x) => ({ n: acc.n + x, label: acc.label }))
const pair = (a: IntVal, b: IntVal): IntVal uses Store.count => a + b + Store.count()
export const hoistOrder = (x: IntVal): IntVal uses Store.count => pair(add(x, 1), Store.count())
export const adderShort = (n: IntVal): (x: IntVal) => IntVal => (x) => x + n
export const adderBlock = (n: IntVal): (x: IntVal) => IntVal => (x) => {
  const y = x + n
  y * 2
}
export const statusLong = (s: Status, longerNameForTheSubject: StrVal): StrVal =>
  match s { "pending" => "pendingpendingpendingpending", "paid" => "paidpaidpaidpaidpaidpaid" }
export const matchLongEff = (id: Id): IntVal
  uses Store.count | Store.tick =>
  match Store.count() {
    1 => 1000000000,
    2 => 2000000000,
    3 => 3000000000,
    _ => 4000000000
  }
export const shapeEff = (s: Shape): IntVal
  uses Store.count =>
  match s {
    { kind: "circle", ...c } => Store.count() + 1,
    { kind: "square", ...q } => Store.count() + 2
  }

// Long expressions and broken arrow chains (A6c). The printer lays out each of
// them as `deno fmt` does, so that the emitted file is a fixed point of it.
type WideF = (z: int) => int
type WideG = (gammaValueNumberThree: int, delta: int) => int
type WideH = (zzzz: int, yyyyy: int, xxxxxx: int) => int

export const wideCond = (alphaValueNumberOne: IntVal, betaValueNumberTwo: IntVal, gammaValueNumberThree: IntVal): BoolVal =>
  alphaValueNumberOne > betaValueNumberTwo && betaValueNumberTwo > gammaValueNumberThree && gammaValueNumberThree > 0 && alphaValueNumberOne < 1000

export const wideCondBlock = (alphaValueNumberOne: IntVal, betaValueNumberTwo: IntVal, gammaValueNumberThree: IntVal): BoolVal => {
  const first: BoolVal = alphaValueNumberOne > betaValueNumberTwo && betaValueNumberTwo > gammaValueNumberThree && gammaValueNumberThree > 0
  first && alphaValueNumberOne > betaValueNumberTwo && betaValueNumberTwo > gammaValueNumberThree && gammaValueNumberThree > 0 && alphaValueNumberOne < 1000
}

export const wideOr = (alphaValueNumberOne: IntVal, betaValueNumberTwo: IntVal, gammaValueNumberThree: IntVal): BoolVal =>
  alphaValueNumberOne > betaValueNumberTwo || betaValueNumberTwo > gammaValueNumberThree && gammaValueNumberThree > 0 || alphaValueNumberOne < 1000 && betaValueNumberTwo > 0

export const wideParens = (alphaValueNumberOne: IntVal, betaValueNumberTwo: IntVal, gammaValueNumberThree: IntVal): BoolVal => {
  const grouped: BoolVal = (alphaValueNumberOne > betaValueNumberTwo || betaValueNumberTwo > gammaValueNumberThree || gammaValueNumberThree > 0 || alphaValueNumberOne < 1000) && (alphaValueNumberOne > betaValueNumberTwo || betaValueNumberTwo > gammaValueNumberThree)
  grouped
}

export const wideIf = (alphaValueNumberOne: IntVal, betaValueNumberTwo: IntVal, gammaValueNumberThree: IntVal): StrVal =>
  if (alphaValueNumberOne > betaValueNumberTwo && betaValueNumberTwo > gammaValueNumberThree && gammaValueNumberThree > 0 && alphaValueNumberOne < 1000) { "a" } else { "b" }

export const wideIfBlock = (alphaValueNumberOne: IntVal, betaValueNumberTwo: IntVal, gammaValueNumberThree: IntVal): StrVal => {
  const picked: StrVal = if (alphaValueNumberOne > betaValueNumberTwo && betaValueNumberTwo > gammaValueNumberThree && gammaValueNumberThree > 0 && alphaValueNumberOne < 1000) { "a" } else { "b" }
  if (alphaValueNumberOne > betaValueNumberTwo && betaValueNumberTwo > gammaValueNumberThree && gammaValueNumberThree > 0 && alphaValueNumberOne < 1000) { picked } else { "b" }
}

export const wideBranches = (alphaValueNumberOne: StrVal, betaValueNumberTwo: StrVal, flag: BoolVal): StrVal =>
  if (flag) { alphaValueNumberOne + "-" + betaValueNumberTwo + "-" + alphaValueNumberOne + "-" + betaValueNumberTwo + "-" + alphaValueNumberOne } else { betaValueNumberTwo + "-" + alphaValueNumberOne + "-" + betaValueNumberTwo + "-" + alphaValueNumberOne + "-" + betaValueNumberTwo }

export const wideSum = (alphaValueNumberOne: IntVal, betaValueNumberTwo: IntVal, gammaValueNumberThree: IntVal): IntVal =>
  alphaValueNumberOne + betaValueNumberTwo + gammaValueNumberThree + alphaValueNumberOne + betaValueNumberTwo + gammaValueNumberThree

export const wideMixed = (alphaValueNumberOne: IntVal, betaValueNumberTwo: IntVal, gammaValueNumberThree: IntVal): IntVal =>
  (alphaValueNumberOne + betaValueNumberTwo * gammaValueNumberThree + alphaValueNumberOne * betaValueNumberTwo + gammaValueNumberThree * 10) * 2

export const wideSub = (alphaValueNumberOne: IntVal, betaValueNumberTwo: IntVal, gammaValueNumberThree: IntVal): IntVal =>
  alphaValueNumberOne - (betaValueNumberTwo - gammaValueNumberThree - alphaValueNumberOne - betaValueNumberTwo - gammaValueNumberThree - alphaValueNumberOne)

export const wideStr = (alphaValueNumberOne: StrVal, betaValueNumberTwo: StrVal, gammaValueNumberThree: StrVal): StrVal =>
  alphaValueNumberOne + "-" + betaValueNumberTwo + "-" + gammaValueNumberThree + "-" + alphaValueNumberOne + "-" + betaValueNumberTwo

export const wideStrBlock = (alphaValueNumberOne: StrVal, betaValueNumberTwo: StrVal, gammaValueNumberThree: StrVal): StrVal => {
  const joined: StrVal = alphaValueNumberOne + "-" + betaValueNumberTwo + "-" + gammaValueNumberThree + "-" + alphaValueNumberOne + "-" + betaValueNumberTwo
  joined + "-" + alphaValueNumberOne + "-" + betaValueNumberTwo + "-" + gammaValueNumberThree + "-" + alphaValueNumberOne + "-" + betaValueNumberTwo
}

export const wideRecord = (alphaValueNumberOne: StrVal, betaValueNumberTwo: StrVal, gammaValueNumberThree: StrVal): Acc =>
  ({ n: 1, label: alphaValueNumberOne + "-" + betaValueNumberTwo + "-" + gammaValueNumberThree + "-" + alphaValueNumberOne + "-" + betaValueNumberTwo })

export const wideFilter = (xs: IntVal[]): IntVal[] =>
  xs |> filter((aVeryLongParameterNameThatFillsTheWholeLineXXX) => aVeryLongParameterNameThatFillsTheWholeLineXXX > 10 && aVeryLongParameterNameThatFillsTheWholeLineXXX < 2000)

export const wideMap = (xs: IntVal[]): StrVal[] =>
  xs |> map((aVeryLongParameterNameThatFillsTheWholeLineXXX) => if (aVeryLongParameterNameThatFillsTheWholeLineXXX > 10 && aVeryLongParameterNameThatFillsTheWholeLineXXX < 2000) { "big" } else { "small" })

export const wideFold = (xs: IntVal[]): IntVal =>
  xs |> fold(0, (accumulatorValueNumberOne, currentValueNumberTwo) => accumulatorValueNumberOne + currentValueNumberTwo + accumulatorValueNumberOne + currentValueNumberTwo + 1)

export const wideGenIf = (alphaValueNumberOne: IntVal, betaValueNumberTwo: IntVal, gammaValueNumberThree: IntVal): StrVal
  uses Store.count =>
  if (alphaValueNumberOne > betaValueNumberTwo && betaValueNumberTwo > gammaValueNumberThree && gammaValueNumberThree > Store.count()) { "a" } else { "b" }

export const wideGenAnd = (alphaValueNumberOne: IntVal, betaValueNumberTwo: IntVal, gammaValueNumberThree: IntVal): BoolVal
  uses Store.count =>
  alphaValueNumberOne > betaValueNumberTwo && Store.count() > 1 && betaValueNumberTwo > gammaValueNumberThree && gammaValueNumberThree > Store.count() && alphaValueNumberOne < 1000

export const wideGenSum = (alphaValueNumberOne: IntVal, betaValueNumberTwo: IntVal, gammaValueNumberThree: IntVal): IntVal
  uses Store.count =>
  alphaValueNumberOne + betaValueNumberTwo + gammaValueNumberThree + Store.count() + alphaValueNumberOne + betaValueNumberTwo

export const wideChain = (alphaValueNumberOne: IntVal, betaValueNumberTwo: IntVal, gammaValueNumberThree: IntVal): WideG => (gammaValueNumberThree, delta) => alphaValueNumberOne
export const wideChainLate = (z: IntVal): WideH => (alphaValueNumberOne, betaValueNumberTwo, gammaValueNumberThree) => alphaValueNumberOne
export const wideChainBlock = (alphaValueNumberOne: IntVal, betaValueNumberTwo: IntVal, gammaValueNumberThree: IntVal): WideG => (gammaValueNumberThree, delta) => {
  const q = alphaValueNumberOne + delta
  q
}
export const wideChainBody = (alphaValueNumberOne: IntVal, betaValueNumberTwo: IntVal): WideG => (gammaValueNumberThree, delta) => alphaValueNumberOne + betaValueNumberTwo + gammaValueNumberThree

export const wideLocalChain = (n: IntVal): IntVal => {
  const adder = (alphaValueNumberOne: IntVal, betaValueNumberTwo: IntVal, gammaValueNumberThree: IntVal) => (z: IntVal) => alphaValueNumberOne + betaValueNumberTwo + gammaValueNumberThree + z
  adder(n, n, n)(n)
}

const wideArgChain = (xs: IntVal[]) => xs |> map((aVeryLongParameterNameThatFillsTheWholeLineXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX) => (q: IntVal) => aVeryLongParameterNameThatFillsTheWholeLineXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX + q)

export const wideElseIf = (alphaValueNumberOne: IntVal, betaValueNumberTwo: IntVal, gammaValueNumberThree: IntVal): StrVal => {
  const picked: StrVal = if (alphaValueNumberOne > betaValueNumberTwo) { "aaaaaaaaaaaaaaaaaaaaaa" } else if (betaValueNumberTwo > gammaValueNumberThree) { "bbbbbbbbbbbbbbbbbbbbbbb" } else if (gammaValueNumberThree > 100000 && alphaValueNumberOne < 10000000 && betaValueNumberTwo > 100) { "c" } else { "d" }
  if (alphaValueNumberOne > betaValueNumberTwo && betaValueNumberTwo > gammaValueNumberThree && gammaValueNumberThree > 0) { picked } else if (alphaValueNumberOne < betaValueNumberTwo && betaValueNumberTwo < gammaValueNumberThree && gammaValueNumberThree < 0) { "b" } else { "c" }
}

const wideFoldChain = (xs: IntVal[]) => xs |> fold((q: IntVal) => q, (accumulatorValueNumberOneXXXXXXXXXXXXXXXXX, currentValueNumberTwoXXXXXXXXXXXXXXXXXXXXXX) => (q: IntVal) => q + 1)

type IntVal = int
type NumVal = number
type StrVal = string
type BoolVal = boolean
