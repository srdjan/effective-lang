nominal UserId = string

export nominal User = {
  id: UserId,
  name: string,
  active: boolean,
  nickname?: string
}

type Dog = {
  id: UserId,
  name: string,
  active: boolean,
  nickname?: string
}

export const make = (): User =>
  User({ id: UserId("u1"), name: "Ann", active: false })

export const nameOf = (user: User): Text => user.name

export const nick = (user: User): Text =>
  match user.nickname {
    Some(n) => n,
    None => "none"
  }

export const activate = (user: User): User =>
  ({ ...user, active: true })

export const plain = (user: User): Dog => unbrand(user)

type Text = string
