type UserId = string

type Text = string

type Flag = boolean

export type User = {
  id: UserId,
  name: Text,
  active: Flag,
  nickname?: Text
}

type Dog = {
  id: UserId,
  name: Text,
  active: Flag,
  nickname?: Text
}

// A union alias of the module tags the records that it lists.
type Pets = User | Dog

export const make = (): User =>
  User({ id: UserId("u1"), name: "Ann", active: false })

export const nameOf = (user: User): Text => user.name

export const nick = (user: User): Text =>
  match user.nickname {
    Some(n) => n,
    None => "none"
  }

export const activate = (user: User): User =>
  ({ ...user, active: true })

export const plain = (user: User): { id: UserId, name: Text, active: Flag, nickname?: Text } =>
  user
