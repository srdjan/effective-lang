export error AVeryLongErrorNameThatKeepsGoingAndGoing = { id: string }
export error AnotherLongErrorNameThatKeepsGoingOnAndOn = { why: string }
export type AVeryLongBrandNameThatKeepsGoingAndGoingOn = string
export type Status = "a-very-long-literal-member-one" | "a-very-long-literal-member-two" | "three"
export type Shape = { kind: "a-very-long-tag-name-that-is-long-enough-to-break-the-line-xxxxxx", r: int } | { kind: "sq", side: int }
export service AVeryLongServiceNameThatKeepsGoingAndGoing {
  find(id: StrVal): StrVal fails AVeryLongErrorNameThatKeepsGoingAndGoing
}
export const look = (id: StrVal): StrVal uses AVeryLongServiceNameThatKeepsGoingAndGoing.find =>
  try { AVeryLongServiceNameThatKeepsGoingAndGoing.find(id) } catch { AVeryLongErrorNameThatKeepsGoingAndGoing(e) => "missing" }
export const tag = (s: Status): IntVal => match s {
  "a-very-long-literal-member-one" => 1,
  "a-very-long-literal-member-two" => 2,
  "three" => 3
}
export const label = (s: StrVal): IntVal => match s {
  "a very long string literal that pushes the selector test past eighty columns" => 1,
  "short" => 2,
  _ => 3
}
export const area = (s: Shape): IntVal => match s {
  { kind: "a-very-long-tag-name-that-is-long-enough-to-break-the-line-xxxxxx", ...c } => c.r,
  { kind: "sq", ...q } => q.side
}
export const say = (): StrVal => "a string literal that is long enough to pass the eighty column limit of the printer"
export type Failure = AVeryLongErrorNameThatKeepsGoingAndGoing | AnotherLongErrorNameThatKeepsGoingOnAndOn
export const describe = (e: Failure): StrVal => match e {
  AVeryLongErrorNameThatKeepsGoingAndGoing(a) => a.id,
  AnotherLongErrorNameThatKeepsGoingOnAndOn(b) => b.why
}
export service Plain {
  count(): IntVal
}
export const total = (): IntVal uses Plain.count => Plain.count()
export const effLater = (s: StrVal): IntVal uses Plain.count => match s {
  "short" => Plain.count(),
  "a very long string literal that pushes the selector test past eighty columns" => 2,
  _ => 4
}

type StrVal = string
type IntVal = int
