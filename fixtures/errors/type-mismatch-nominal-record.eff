type UserId = string

type User = { id: UserId, name: string, active: boolean }

type Dog = { id: UserId, name: string, active: boolean }

// A union alias of the module tags the records that it lists.
type Pet = User | Dog

const activate = (user: User): User => ({ ...user, active: true })

const dog: Dog = { id: UserId("d1"), name: "barki", active: false }

const wrong = (): User =>
  // error: type-mismatch/003
  activate(dog)

const literal = (): User => ({ id: UserId("u2"), name: "Bo", active: true })
