type UserId = string

type Email = string

type Text = string

type Flag = boolean

type User = { id: UserId, name: Text, nick?: Text }

type Twin = { id: UserId, name: Text, nick?: Text }

// A union alias of the module tags the records that it lists.
type Account = User | Twin

const make = (): User => User({ id: UserId("u1"), name: "Ann" })

// A record literal at a tagged record is a construction.
const implicit = (): User => ({ id: UserId("u2"), name: "Bo" })

const structural = (value: { id: UserId, name: Text, nick?: Text }): User =>
  // error: type-mismatch/003
  value

const asRecord = (user: User): { id: UserId, name: Text, nick?: Text } => user

const asTwin = (user: User): Twin =>
  // error: type-mismatch/003
  user

const wrapped = (user: User): Twin => Twin(user)

const asBase = (id: UserId): Text => Text(id)

const asNominal = (email: Email): UserId =>
  // error: type-mismatch/003
  email

const sameId = (id: UserId): Flag => id === "u1"

const otherId = (id: UserId, email: Email): Flag =>
  // error: type-mismatch/007
  id === email

const same = (a: User, b: User): Flag =>
  // error: type-mismatch/007
  a === b
