error Missing = { id: string }

const find = (id: string): string
  fails Missing => fail(Missing({ id }))

const bad = (id: string): string =>
  try {
    find(id)
  } catch {
    Missing(first) => "a",
    // error: failure-contract/003
    Missing(second) => "b"
  }

error Absent = { id: string }

const twice = (id: string): string =>
  try {
    find(id)
  } catch {
    Missing(m) => "a",
    // error: failure-contract/002
    Absent(first) => "b",
