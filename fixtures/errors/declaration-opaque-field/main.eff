import { Conn, Text, Plain } from "host:x"

type Conns = Conn[]

// error: declaration/016
type Direct = { conn: Conn }

// error: declaration/016
error Failed = { conn: Conn }

type Wrapped = {
  // error: declaration/016
  maybe: Option<Conn>,
  // error: declaration/016
  pair: [Text, Conn],
  // error: declaration/016
  nested: { inner: Conn },
  // error: declaration/016
  either: Text | Conn
}

// error: declaration/016
type ThroughAlias = { conns: Conns }

// The alias that the field names comes later in the file.
// error: declaration/016
error Late = { later: LaterConns }

type LaterConns = Conn[]

type Fine = { label: Text, plain: Plain, direct: Direct, raw: unknown }

// A union alias of the module tags each record that it lists.
type Tagged = Direct | Wrapped | ThroughAlias | Fine

export const main = (c: Conn): Conn => c
