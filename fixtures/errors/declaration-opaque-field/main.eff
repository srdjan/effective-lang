import { Conn, Text, Plain } from "host:x"

type Conns = Conn[]

// error: declaration/016
data Direct = { conn: Conn }

// error: declaration/016
error Failed = { conn: Conn }

data Wrapped = {
  // error: declaration/016
  maybe: Option<Conn>,
  // error: declaration/016
  pair: [Text, Conn],
  // error: declaration/016
  nested: { inner: Conn },
  // error: declaration/016
  either: Text | Conn
}

// error: declaration/016
data ThroughAlias = { conns: Conns }

// The alias that the field names comes later in the file.
// error: declaration/016
error Late = { later: LaterConns }

type LaterConns = Conn[]

// error: declaration/016
type Handle = Brand<Conn>

data Fine = { label: Text, plain: Plain, direct: Direct, raw: unknown }

export const main = (c: Conn): Conn => c
