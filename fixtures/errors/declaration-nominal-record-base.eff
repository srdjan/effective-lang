type Text = string

type Plain = { id: Text }

nominal Row = { id: Text }

// A body that is a record after aliases unfold is a nominal record.
nominal FromRecord = { id: Text }

nominal FromAlias = Plain

// The alias may come after the nominal type.
nominal FromLater = Later

type Later = { id: Text }

// error: declaration/014
nominal FromNominal = Row

// error: declaration/014
nominal FromUnion = Row | Text

// error: declaration/014
nominal FromRecordUnion = Plain | Text

nominal FromString = Text

nominal FromArray = Plain[]

nominal FromLiterals = "a" | "b"

nominal FromOption = Option<Plain>

nominal FromNominalString = FromString
