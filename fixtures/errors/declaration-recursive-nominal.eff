// A cycle that passes through an array, an Option, or a union with an outside member is legal.
nominal Tree = { children: Tree[] }

nominal Opt = { next: Option<Opt> }

nominal Forest = { first: Option<Node> }

nominal Node = { rest: Forest }

nominal Cons = { tail: List }

nominal Nil = {}

type List = Cons | Nil

// A cycle of required fields only has no base case.
// error: declaration/007
nominal Loop = { next: Loop }

// error: declaration/007
nominal Ping = { pong: Pong }

nominal Pong = { ping: Ping }

// A union with no member outside the cycle has no base case.
// error: declaration/007
nominal Left = { next: Left | Right }

nominal Right = { next: Left }

// A cycle of aliases alone stays rejected, even beside a data type.
// error: declaration/007
type First = Second

type Second = First | Anchor

nominal Anchor = { next: Option<Second> }

// A cycle through an error keeps the old rule.
// error: declaration/007
nominal Wraps = { cause: Option<Failure> }

error Failure = { inner: Option<Wraps> }
