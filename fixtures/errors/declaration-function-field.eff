type Count = int

type Step = (n: Count) => Count

type Steps = Step[]

// error: declaration/015
type Direct = { run: (n: Count) => Count }

// error: declaration/015
error Failed = { run: (n: Count) => Count }

type Wrapped = {
  // error: declaration/015
  maybe: Option<Step>,
  // error: declaration/015
  many: ((n: Count) => Count)[],
  // error: declaration/015
  nested: { inner: Step },
  // error: declaration/015
  either: Count | Step
}

// error: declaration/015
type ThroughAlias = { steps: Steps }

// The alias that the field names comes later in the file.
// error: declaration/015
error Late = { later: LaterSteps }

type LaterSteps = Step[]

type Deferred = {
  // error: declaration/015
  job: Effect<Count>,
  // error: declaration/015
  cell: Ref<Count>,
  // error: declaration/015
  items: Stream<Count>
}

type Fine = { count: Count, direct: Direct, raw: unknown }

error FineToo = { count: Count }

// A union alias of the module tags each record that it lists.
type Tagged = Direct | Wrapped | ThroughAlias | Deferred | Fine
