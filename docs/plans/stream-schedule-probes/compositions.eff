type Int = int
type Bool = boolean
type Event = { kind: "Value" | "End", value: Int }
const endStep: [Event, Bool] = [{ kind: "End", value: 0 }, true]

export error SourceError = {}
export error SignalError = {}
export error RetryError = {}
export service Source { next(state: Int): Option<[Int, Int]> fails SourceError }
export service Signal { wait(): void fails SignalError }

const source = unfold(0, (state) => Source.next(state))
const values = mapStream(source, (value): Event => ({ kind: "Value", value }))
const ended = concatStreams(values, unfold(false, (done): Option<[Event, Bool]> =>
  if (done) { None } else { Some(endStep) }))
const signal = unfold(false, (done): Option<[Event, Bool]> fails SignalError uses Signal.wait =>
  if (done) { None } else {
    Signal.wait()
    Some(endStep)
  })

const merged = mergeStreams(ended, signal)
const prefix = takeUntilStream(merged, (event) => event.kind === "End")
const selected = filterStream(prefix, (event) => event.kind === "Value")
export const stopped: Stream<Int, SourceError | SignalError, Source.next | Signal.wait> =
  mapStream(selected, (event) => event.value)

// A fixed combination of retry counts and delays needs no general Schedule.
export const combined: RetrySchedule<RetryError> =
  retrySchedule((_: RetryError, attempt: Int): Option<Int> =>
    if (attempt < 4) {
      const backoff = attempt * 5
      Some(if (backoff > 10) { backoff } else { 10 })
    } else { None })

// The emitted target fixes the leftover parameter to never.
export type PairSink = Sink<Int, Int[]>
