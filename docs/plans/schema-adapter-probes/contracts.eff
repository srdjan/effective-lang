export type Int = int
export type Text = string
export error AdapterError = { operation: Text }
export service Policy { allow(): void fails AdapterError }
export service Operations {
  lookup(value: Int): Int fails AdapterError
  tree(body: Text): Int fails AdapterError
  http(body: Text): Int fails AdapterError
  sql(mode: Text): Int fails AdapterError
  rpc(body: Text): Int fails AdapterError
  ai(prompt: Text): Text fails AdapterError
  metric(): Int
}
