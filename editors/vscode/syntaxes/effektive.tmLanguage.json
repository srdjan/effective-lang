{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Effektive",
  "scopeName": "source.effektive",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#declaration-words"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#builtin-types"
    },
    {
      "include": "#builtin-functions"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#types"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.effektive",
          "match": "//.*$"
        },
        {
          "name": "comment.block.effektive",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.effektive",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        {
          "name": "constant.character.escape.effektive",
          "match": "\\\\(?:[\\\\\"/bfnrt]|u[0-9A-Fa-f]{4})"
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.effektive",
      "match": "\\b[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?\\b"
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.import.effektive",
          "match": "\\b(?:import|export)\\b"
        },
        {
          "name": "keyword.control.effektive",
          "match": "\\b(?:match|try|catch|if|else)\\b"
        },
        {
          "name": "storage.type.effektive",
          "match": "\\bconst\\b"
        },
        {
          "name": "keyword.control.resource.effektive",
          "match": "\\b(?:finally|using(?=\\s*\\(\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*=))\\b"
        }
      ]
    },
    "declaration-words": {
      "patterns": [
        {
          "name": "storage.type.declaration.effektive",
          "match": "\\b(?:type|error|service|provider)\\b"
        },
        {
          "name": "storage.type.declaration.effektive",
          "match": "\\bnominal\\b(?=\\s+[A-Za-z_$][A-Za-z0-9_$]*\\s*=)"
        },
        {
          "name": "storage.modifier.effektive",
          "match": "\\bsealed\\b(?=\\s+nominal\\s+[A-Za-z_$][A-Za-z0-9_$]*\\s*=)"
        },
        {
          "name": "keyword.other.clause.effektive",
          "match": "\\b(?:fails|uses|provides|from)\\b"
        },
        {
          "name": "storage.modifier.effektive",
          "match": "\\bpure\\b(?=\\s*\\([^\\n]*\\)\\s*=>)"
        }
      ]
    },
    "constants": {
      "name": "constant.language.effektive",
      "match": "\\b(?:true|false|null)\\b"
    },
    "builtin-types": {
      "name": "support.type.builtin.effektive",
      "match": "\\b(?:string|boolean|int|number|void|never|unknown|Option|Effect|Stream|Sink|Schedule|ScheduleInput|ScheduleMetadata|ScheduleDecision|Schema|SchemaOptional|SchemaEncodedOptional|SchemaDecodedOptional|SchemaConstructorDefault|SchemaOptionalConstructorDefault|SchemaEncodedOptionalConstructorDefault|SchemaDecodedOptionalConstructorDefault|SchemaIssue|SchemaError|CloseableScope|Ref|RetrySchedule|Codec|Fiber)\\b"
    },
    "builtin-functions": {
      "patterns": [
        {
          "name": "support.function.builtin.effektive",
          "match": "\\b(?:map|filter|fold|traverse|all|partitionAll|validateAll|allResults|retry|retrySchedule|scheduleFromStep|scheduleRecurs|scheduleSpaced|scheduleMap|scheduleMax|scheduleMin|scheduleConcat|codec|schema|schemaArray|schemaStruct|schemaOptionalKey|schemaNullToMissingKey|schemaOptionFromOptionalKey|schemaDefaultKey|schemaConstructorDefault|schemaOptionalTransform|schemaOptionalFromRequired|schemaUnion|schemaTransform|schemaRecursive|schemaDecode|schemaEncode|schemaMake|schemaInvalid|schemaAt|schemaBoth|decode|encode|withFiber|joinFiber|interruptFiber|forkScoped|scoped|makeScope|provideScope|addScopeFinalizer|closeScope|provide|defer|run|withResource|unfold|mapEffect|mapGroups|scanStream|mapAccumStream|foldStream|foldEffectStream|collectStream|headStream|lastStream|drainStream|flatMapStreams|switchMapStreams|catchStream|retryStream|debounceStream|throttleStream|filterEffectStream|takeWhileEffectStream|takeUntilEffectStream|dropWhileEffectStream|takeStream|dropStream|sinkForEach|takeSink|transduceStream|aggregateStream|aggregateWithinStream|runStream|bufferStream|mergeStreams|zipStreams|concatStreams|race|makeRef|getRef|setRef|updateRef|layer|mergeLayers|fail)\\b"
        },
        {
          "name": "support.constant.builtin.effektive",
          "match": "\\b(?:Some|None)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.option.effektive",
          "match": "\\?\\?"
        },
        {
          "name": "keyword.operator.pipe.effektive",
          "match": "\\|>"
        },
        {
          "name": "storage.type.function.arrow.effektive",
          "match": "=>"
        },
        {
          "name": "keyword.operator.spread.effektive",
          "match": "\\.\\.\\."
        },
        {
          "name": "keyword.operator.comparison.effektive",
          "match": "===|!==|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.effektive",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.arithmetic.effektive",
          "match": "[-+*/]"
        },
        {
          "name": "keyword.operator.type.union.effektive",
          "match": "\\|"
        },
        {
          "name": "keyword.operator.assignment.effektive",
          "match": "="
        }
      ]
    },
    "types": {
      "name": "entity.name.type.effektive",
      "match": "\\b[A-Z][A-Za-z0-9_$]*\\b"
    }
  }
}
