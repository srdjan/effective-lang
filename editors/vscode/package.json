{
  "name": "effektive-vscode",
  "displayName": "Effektive",
  "description": "Language support for Effektive, including diagnostics, navigation, refactoring, completion, and generated TypeScript.",
  "version": "0.8.0",
  "publisher": "local",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.91.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:effektive",
    "onCommand:effektive.showGeneratedTypeScript"
  ],
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "effektive",
        "aliases": [
          "Effektive"
        ],
        "extensions": [
          ".eff",
          ".effi"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "effektive",
        "scopeName": "source.effektive",
        "path": "./syntaxes/effektive.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "effektive.showGeneratedTypeScript",
        "title": "Effektive: Show Generated TypeScript"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "effektive.showGeneratedTypeScript",
          "when": "editorLangId == effektive",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "effektive.showGeneratedTypeScript",
          "when": "editorLangId == effektive"
        }
      ]
    },
    "configuration": {
      "title": "Effektive",
      "properties": {
        "effektive.server.deno": {
          "type": "string",
          "default": "deno",
          "description": "The Deno 2.9.8 executable that starts the language server."
        },
        "effektive.server.repository": {
          "type": "string",
          "default": "",
          "description": "Development override: path of an effektive-lang checkout. Empty uses the language server bundled in the extension."
        },
        "effektive.writeOnSave": {
          "type": "boolean",
          "default": true,
          "description": "When the user saves a source file, write every generated .ts and .ts.map file that changed, from the saved files on disk."
        },
        "effektive.debounceMs": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Delay in milliseconds before the server compiles after an edit."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "10.1.2"
  }
}
