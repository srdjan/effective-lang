{
  "tasks": {
    "check": "deno fmt --check && deno lint && deno check 'src/**/*.ts' 'tests/**/*.ts' 'scripts/**/*.ts' && deno task test && deno task test:slow",
    "test": "deno test --allow-read --ignore='**/*_slow_test.ts' tests/",
    "test:slow": "deno test --allow-all --permit-no-files 'tests/**/*_slow_test.ts'",
    "effective": "deno run --allow-read --allow-write --allow-run=deno src/cli/main.ts",
    "golden:update": "deno run --allow-read --allow-write scripts/golden_update.ts",
    "validate:update": "deno run --allow-read --allow-write scripts/validate_fixtures.ts",
    "fmt": "deno fmt",
    "lint": "deno lint"
  },
  "compilerOptions": {
    "strict": true,
    "exactOptionalPropertyTypes": true
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1"
  },
  "fmt": {
    "proseWrap": "preserve",
    "exclude": [
      "docs/",
      "src/core/ir.ts",
      "fixtures/**/*.eff",
      "fixtures/**/*.effi"
    ]
  },
  "lint": {
    "exclude": ["docs/", "fixtures/golden/"]
  }
}
