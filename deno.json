{
  "name": "@srdjan/effektive-lang",
  "version": "0.7.1",
  "license": "MIT",
  "exports": {
    ".": "./src/core/mod.ts",
    "./frontend": "./src/core/frontend.ts",
    "./typescript": "./src/core/typescript.ts"
  },
  "exclude": [
    ".claude/worktrees/",
    "dist/"
  ],
  "tasks": {
    "check": "deno fmt --check && deno lint && deno check 'src/**/*.ts' 'playground/**/*.ts' 'tests/**/*.ts' 'scripts/**/*.ts' 'bench/**/*.ts' && deno task test && deno task test:slow",
    "test": "deno test --allow-read --ignore='**/*_slow_test.ts' tests/",
    "test:slow": "deno run --allow-run --allow-read --allow-write scripts/test_slow.ts",
    "effektive": "deno run --allow-read --allow-write --allow-run=deno src/cli/main.ts",
    "lsp": "deno run --allow-read --allow-write src/lsp/main.ts",
    "bench": "deno run --no-lock --allow-read --allow-write --allow-run=deno --allow-env bench/main.ts",
    "golden:update": "deno run --allow-read --allow-write scripts/golden_update.ts",
    "validate:update": "deno run --allow-read --allow-write scripts/validate_fixtures.ts",
    "lex:update": "deno run --allow-read --allow-write --allow-run=git scripts/lex_snapshot.ts",
    "behavior:capture": "deno run --allow-all scripts/behavior_capture.ts",
    "measure": "deno run --allow-read --allow-env scripts/measure.ts",
    "measure:functions": "deno run --allow-read --allow-env scripts/measure_functions.ts",
    "playground:build": "deno run --allow-read --allow-write --allow-run=deno playground/build.ts",
    "playground:serve": "deno run --allow-read --allow-write --allow-run=deno --allow-net=127.0.0.1:8790 playground/serve.ts",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "package": "deno run --allow-read --allow-write --allow-run=deno,npm --allow-env scripts/package.ts",
    "test:installation": "deno test --allow-all tests/installation_slow_test.ts",
    "test:vscode": "deno run --allow-all scripts/package_vscode_smoke.ts"
  },
  "compilerOptions": {
    "strict": true,
    "exactOptionalPropertyTypes": true
  },
  "imports": {
    "@codemirror/commands": "npm:@codemirror/commands@6.11.1",
    "@codemirror/lang-javascript": "npm:@codemirror/lang-javascript@6.2.5",
    "@codemirror/language": "npm:@codemirror/language@6.13.1",
    "@codemirror/lint": "npm:@codemirror/lint@6.9.7",
    "@codemirror/state": "npm:@codemirror/state@6.7.6",
    "@codemirror/view": "npm:@codemirror/view@6.43.14",
    "@lezer/highlight": "npm:@lezer/highlight@1.2.5",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/http": "jsr:@std/http@1.1.3",
    "@std/path": "jsr:@std/path@^1",
    "codemirror": "npm:codemirror@6.0.2",
    "typescript": "npm:typescript@5.9.3"
  },
  "fmt": {
    "proseWrap": "preserve",
    "exclude": [
      "docs/",
      "src/core/ir.ts",
      "fixtures/**/*.eff",
      "fixtures/**/*.effi",
      "editors/vscode/node_modules/",
      "playground/dist/"
    ]
  },
  "lint": {
    "exclude": [
      "docs/",
      "fixtures/golden/",
      "editors/vscode/",
      "playground/dist/"
    ]
  }
}
